# ---- Anthropic (Claude API) ----
# Used by the interpretation pipeline. Model: claude-sonnet-4-6.
ANTHROPIC_API_KEY=sk-ant-...

# ---- Supabase (storage + rate limiting) ----
# Project URL and the *service role* key (server-side only — never expose to the browser).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ---- Resend (email delivery) ----
RESEND_API_KEY=re_...
# Verified sending address. Until DNS is set up, use an onboarding@resend.dev address for testing.
RESEND_FROM="Activity Test <noreply@your-domain.com>"

# ---- App ----
# Public base URL of the deployment (used by the submit handler to trigger the background interpret call).
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Shared secret guarding the internal /api/interpret route.
INTERPRET_TASK_SECRET=replace-me-with-a-long-random-string

# ---- Optional ----
# Comma-separated locales the UI should expose. Defaults to "en,ru" if unset.
# AVAILABLE_LOCALES=en,ru,de,fr,es,it,pt,pl,uk
